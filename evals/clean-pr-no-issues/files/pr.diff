diff --git a/lib/batching.py b/lib/batching.py
--- a/lib/batching.py
+++ b/lib/batching.py
@@ -1,3 +1,5 @@
 def chunk(items, size):
     """Split a list into consecutive lists of at most `size` elements."""
+    if size <= 0:
+        raise ValueError("size must be positive")
     return [items[i:i + size] for i in range(0, len(items), size)]
diff --git a/tests/test_batching.py b/tests/test_batching.py
--- a/tests/test_batching.py
+++ b/tests/test_batching.py
@@ -6,3 +6,7 @@ def test_chunk_even():
 
 def test_chunk_remainder():
     assert chunk([1, 2, 3], 2) == [[1, 2], [3]]
+
+def test_chunk_rejects_nonpositive_size():
+    with pytest.raises(ValueError):
+        chunk([1], 0)
