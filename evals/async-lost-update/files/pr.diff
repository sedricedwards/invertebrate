diff --git a/svc/credits.py b/svc/credits.py
new file mode 100644
--- /dev/null
+++ b/svc/credits.py
@@ -0,0 +1,19 @@
+import logging
+from svc.store import KV
+
+log = logging.getLogger(__name__)
+store = KV()
+
+async def charge(account: str, amount: int) -> bool:
+    try:
+        balance = await store.get(f"credits:{account}")
+        if balance < amount:
+            return False
+        await store.set(f"credits:{account}", balance - amount)
+        return True
+    except Exception:
+        pass
+
+async def refund(account: str, amount: int) -> None:
+    balance = await store.get(f"credits:{account}")
+    await store.set(f"credits:{account}", balance + amount)
diff --git a/svc/worker.py b/svc/worker.py
new file mode 100644
--- /dev/null
+++ b/svc/worker.py
@@ -0,0 +1,6 @@
+import asyncio
+from svc.credits import charge
+
+async def process_batch(jobs):
+    results = await asyncio.gather(*(charge(j["account"], j["cost"]) for j in jobs))
+    return [j for j, ok in zip(jobs, results) if ok]
