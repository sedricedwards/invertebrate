{
  "description": "Export the GitHub token you entered in plugin settings as GH_TOKEN for gh. Does nothing if left blank.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "[ -n \"$CLAUDE_PLUGIN_OPTION_GITHUB_TOKEN\" ] && [ -n \"$CLAUDE_ENV_FILE\" ] && echo \"export GH_TOKEN='$CLAUDE_PLUGIN_OPTION_GITHUB_TOKEN'\" >> \"$CLAUDE_ENV_FILE\"; exit 0"
          }
        ]
      }
    ]
  }
}
